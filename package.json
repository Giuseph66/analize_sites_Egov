{
  "name": "local-accessibility-evaluator",
  "private": true,
  "version": "0.1.0",
  "description": "Laboratorio local de avaliacao de acessibilidade web, motor QualWeb",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "experiments/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "PORT=3001 npm run dev --workspace=@lae/api",
    "dev:frontend": "npm run dev --workspace=@lae/frontend",
    "build": "npm run typecheck && npm run build --workspace=@lae/frontend",
    "start": "npm run start --workspace=@lae/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.scripts.json",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "evaluate": "npm run evaluate --workspace=@lae/qualweb-test --",
    "compare": "tsx scripts/compare-evaluators.ts",
    "test-sites:bad": "node scripts/serve-test-sites.mjs bad 5173",
    "test-sites:good": "node scripts/serve-test-sites.mjs good 5174",
    "logs": "tail -n 200 -f logs/application.log",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "axe-core": "^4.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
