# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Navegador
# ---------------------------------------------------------------------------
# false abre uma janela real do Chromium. So funciona fora do container, num
# ambiente com servidor grafico.
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
PAGE_TIMEOUT=30000
# Caminho de um Chromium/Chrome especifico. Vazio = usa o Chrome que o Puppeteer baixou.
BROWSER_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# Limites (§22)
# ---------------------------------------------------------------------------
EVALUATION_TIMEOUT=60000
MAX_CONCURRENT_EVALUATIONS=2
MAX_QUEUE_SIZE=20

# ---------------------------------------------------------------------------
# Diagnostico (§14, §15)
# ---------------------------------------------------------------------------
# Grava data/evaluations/<id>/screenshot.png
CAPTURE_SCREENSHOT=false
# Grava data/evaluations/<id>/page.html. Ferramenta local: nao habilite ao
# avaliar paginas com conteudo sensivel.
SAVE_HTML=false

# ---------------------------------------------------------------------------
# Politica de URL (§21)
# ---------------------------------------------------------------------------
# Avaliar localhost e o proposito da ferramenta, entao o padrao e permitir.
ALLOW_LOCAL_NETWORK=true
ALLOW_FILE_PROTOCOL=false
MAX_REDIRECTS=10

# Espera de "assentamento" do DOM depois do load, para SPAs client-side-rendered
# (ex.: roteadores em hash que so populam o conteudo real segundos apos o load).
# SPA_SETTLE_QUIET_MS: janela sem mutacoes no DOM para considerar assentado.
# SPA_SETTLE_MAX_MS: teto da espera extra. 0 desativa o recurso.
SPA_SETTLE_QUIET_MS=500
SPA_SETTLE_MAX_MS=4000

# Host que substitui localhost/127.0.0.1 dentro do container.
# Fora do Docker deixe vazio.
LOCALHOST_ALIAS=
RUNNING_IN_DOCKER=

# ---------------------------------------------------------------------------
# Relatorio
# ---------------------------------------------------------------------------
SCORING_STRATEGY=experimental-v1
DATA_DIR=data
LOGS_DIR=logs
